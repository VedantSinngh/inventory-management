# =========================================================================
# SERVER CONFIGURATION
# =========================================================================
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/inventorySystem

# =========================================================================
# AUTH CONFIGURATION
# =========================================================================
# JWT signing secret (min 32 characters, cryptographically random)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_replace_me_now
# JWT token expiration duration (e.g. 30d, 24h, 1h)
JWT_EXPIRES_IN=30d

# =========================================================================
# EMAIL CONFIGURATION
# =========================================================================
# SMTP Configuration for Nodemailer (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@inventory-system.com
SUPPORT_EMAIL=support@inventory-system.com

# Legacy SendGrid settings (Optional/Legacy, no longer required)
# SENDGRID_API_KEY=SG.legacy_key_here
# SENDGRID_FROM_EMAIL=noreply@legacy-system.com

# =========================================================================
# WEATHER CONFIGURATION
# =========================================================================
# Open-Meteo is used by default (free, no API key required).
# Under validateEnv.js, no weather API key is required.

# =========================================================================
# MAPS CONFIGURATION
# =========================================================================
# Maps provider ('osm' is the free OpenStreetMap Nominatim/OSRM default)
MAPS_PROVIDER=osm
# Optional keys (always optional, no longer required)
# MAPBOX_API_KEY=your_legacy_mapbox_key_here
# GOOGLE_MAPS_API_KEY=your_legacy_google_maps_key_here

# =========================================================================
# LLM CONFIGURATION
# =========================================================================
# LLM Provider: groq (default, free), openai, anthropic, or ollama
LLM_PROVIDER=groq
# API key for the selected provider (required only for groq, openai, anthropic)
LLM_API_KEY=gsk_your_groq_api_key_here
# Default model to use (defaults: llama-3.3-70b-versatile for groq, gpt-4o-mini for openai, claude-haiku-4-5 for anthropic, llama3 for ollama)
LLM_MODEL=llama-3.3-70b-versatile
# Custom endpoint baseURL (mostly for ollama local runs, e.g., http://localhost:11434/v1)
LLM_ENDPOINT=https://api.groq.com/openai/v1

# =========================================================================
# OPTIONAL CONFIGURATIONS
# =========================================================================
# Frontend URLs for CORS configuration and email verification links
CORS_ORIGIN=http://localhost:3000
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis connection URL (Optional, for caching)
REDIS_URL=
# HTTPS configuration
HTTPS_ONLY=false
